---
# The IaC engine package. Installing this Provider makes Crossplane run a
# controller that reconciles Workspace resources by shelling out to OpenTofu.
# No ControllerConfig/DeploymentRuntimeConfig — we don't need to tune the pod yet.
apiVersion: pkg.crossplane.io/v1
kind: Provider
metadata:
  name: {{ engine_provider_name }}
spec:
  package: {{ engine_provider_package }}
